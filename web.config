<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Force CORS headers for ALL responses -->
    <httpProtocol>
      <customHeaders>
        <!-- CORS -->
        <add name="Access-Control-Allow-Origin" value="https://j-prep2025.vercel.app" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />
        <add name="Access-Control-Allow-Credentials" value="true" />

        <!-- Required to allow Google OAuth popup to close -->
        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
        <add name="Cross-Origin-Embedder-Policy" value="unsafe-none" />
      </customHeaders>
    </httpProtocol>

    <!-- Allow Azure to handle OPTIONS preflight correctly -->
    <handlers>
      <add name="OPTIONSVerbHandler" path="*" verb="OPTIONS"
           modules="IsapiModule" scriptProcessor=""
           resourceType="Unspecified" requireAccess="None" />
    </handlers>

    <security>
      <requestFiltering>
        <verbs>
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
