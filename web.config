<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- Always add these headers to every response -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="https://j-prep2025.vercel.app" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization" />
        <add name="Access-Control-Allow-Credentials" value="true" />

        <add name="Cross-Origin-Opener-Policy" value="same-origin-allow-popups" />
        <add name="Cross-Origin-Embedder-Policy" value="unsafe-none" />
      </customHeaders>
    </httpProtocol>

    <!-- Return 200 for OPTIONS preflight -->
    <rewrite>
      <rules>
        <rule name="HandleOPTIONS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="OPTIONS" />
          </conditions>
          <action type="CustomResponse" statusCode="200" statusReason="OK" statusDescription="CORS Preflight OK" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
